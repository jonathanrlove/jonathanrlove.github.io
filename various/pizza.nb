Notebook[{
Cell[TextData[{
 "Cut a pizza of radius 1 into ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "1939de0f-793a-4bf4-8df9-d5e193ea1ae4"],
 " equal slices, and fit them in a circle of radius ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    SuperscriptBox["10", "e"]}], TraditionalForm]],ExpressionUUID->
  "e50d97f5-3f27-471a-b3d1-ba617c542d0b"],
 "."
}], "Text",
 CellChangeTimes->{{4.0008277451622543`*^9, 
  4.0008278049215937`*^9}},ExpressionUUID->"88400c1a-5b50-4837-b3f1-\
a88d59146de2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"det", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"Re", "[", "a", "]"}], 
     RowBox[{"Im", "[", "b", "]"}]}], "-", 
    RowBox[{
     RowBox[{"Im", "[", "a", "]"}], 
     RowBox[{"Re", "[", "b", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cross", "[", 
    RowBox[{"x1_", ",", "x2_", ",", "y1_", ",", "y2_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"det", "[", 
       RowBox[{
        RowBox[{"y2", "-", "y1"}], ",", 
        RowBox[{"x1", "-", "y1"}]}], "]"}], 
      RowBox[{"det", "[", 
       RowBox[{
        RowBox[{"y2", "-", "y1"}], ",", 
        RowBox[{"x2", "-", "y1"}]}], "]"}]}], "<", "0"}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"det", "[", 
       RowBox[{
        RowBox[{"x2", "-", "x1"}], ",", 
        RowBox[{"y1", "-", "x1"}]}], "]"}], 
      RowBox[{"det", "[", 
       RowBox[{
        RowBox[{"x2", "-", "x1"}], ",", 
        RowBox[{"y2", "-", "x1"}]}], "]"}]}], "<", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"line", "[", 
    RowBox[{"u_", ",", "z_"}], "]"}], ":=", 
   RowBox[{"Graphics", "[", 
    RowBox[{"Line", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "u", "]"}], ",", 
         RowBox[{"Im", "[", "u", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Re", "[", "z", "]"}], ",", 
         RowBox[{"Im", "[", "z", "]"}]}], "}"}]}], "}"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"update", "[", 
    RowBox[{"z_", ",", "u_", ",", "\[Zeta]_", ",", "\[Epsilon]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", "v"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"(", 
        RowBox[{"u", "-", "z"}], ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"t", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"Re", "[", 
           RowBox[{"\[Zeta]", " ", "v", " ", 
            RowBox[{"Conjugate", "[", "z", "]"}]}], "]"}]}], "+", 
         SqrtBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"Re", "[", 
             RowBox[{"\[Zeta]", " ", "v", " ", 
              RowBox[{"Conjugate", "[", "z", "]"}]}], "]"}], "2"], "-", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"Abs", "[", "z", "]"}], "2"], "-", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", "\[Epsilon]"}], ")"}], "2"]}], ")"}]}]]}], 
        ")"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t", "-", "1"}], ")"}], "\[Zeta]", " ", "v"}], "+", "z"}], 
        ",", 
        RowBox[{
         RowBox[{"t", " ", "\[Zeta]", " ", "v"}], "+", "z"}], ",", 
        RowBox[{
         RowBox[{"\[Zeta]", " ", "v"}], "+", "z"}], ",", "t"}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"n_", ",", "e_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[Zeta]", ",", "\[Epsilon]", ",", "\[Alpha]", ",", "u0", ",", "z0", ",",
        "pts", ",", "u", ",", "z", ",", "lines", ",", 
       RowBox[{"crossed", "=", "False"}]}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\[Zeta]", "=", 
       SuperscriptBox["E", 
        RowBox[{"2", "\[Pi]", " ", 
         RowBox[{"I", "/", "n"}]}]]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Epsilon]", "=", 
       SuperscriptBox["10.0", "e"]}], ";", "\[IndentingNewLine]", 
      RowBox[{"\[Alpha]", "=", 
       RowBox[{"\[Pi]", "+", 
        RowBox[{"ArcSin", "[", 
         FractionBox[
          SqrtBox[
           RowBox[{"2", "\[Epsilon]"}]], 
          RowBox[{"1", "-", "\[Epsilon]"}]], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"u0", "=", 
       RowBox[{"1", "-", "\[Epsilon]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"z0", "=", 
       RowBox[{"1", "-", "\[Epsilon]", "+", 
        SuperscriptBox["E", 
         RowBox[{"I", " ", "\[Alpha]"}]]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"pts", "=", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "z0"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", ",", "z"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{"u0", ",", "z0"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"lines", "=", 
       RowBox[{"{", 
        RowBox[{"line", "[", 
         RowBox[{"u", ",", "z"}], "]"}], "}"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"Not", "[", "crossed", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"zp", ",", "up", ",", "rp", ",", "t"}], "}"}], "=", 
          RowBox[{"update", "[", 
           RowBox[{"z", ",", "u", ",", "\[Zeta]", ",", "\[Epsilon]"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cross", "[", 
             RowBox[{"u0", ",", "z0", ",", "up", ",", "zp"}], "]"}], "||", 
            RowBox[{"cross", "[", 
             RowBox[{"up", ",", "zp", ",", "u", ",", "z"}], "]"}], "||", 
            RowBox[{"t", "<", "1"}]}], ",", 
           RowBox[{"crossed", "=", "True"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"pts", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"pts", ",", 
               RowBox[{"{", 
                RowBox[{"z", ",", "u"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"lines", ",", " ", 
              RowBox[{"line", "[", 
               RowBox[{"up", ",", "z"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"lines", ",", " ", 
              RowBox[{"line", "[", 
               RowBox[{"rp", ",", "u"}], "]"}]}], "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"z", ",", "u"}], "}"}], "=", 
             RowBox[{"{", 
              RowBox[{"zp", ",", "up"}], "}"}]}], ";"}]}], 
          "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"ContourPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            SuperscriptBox["x", "2"], "+", 
            SuperscriptBox["y", "2"]}], "==", 
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{"1", "-", "\[Epsilon]"}], ")"}], "2"]}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"y", ",", 
            RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"ListPlot", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", "[", "#", "]"}], ",", 
             RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], "/@", "pts"}], 
         "]"}], ",", "lines"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"n", ",", "e"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "40"}], "}"}], ",", "10", ",", "1000"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e", ",", 
       RowBox[{"-", "2"}]}], "}"}], ",", 
     RowBox[{"-", "5"}], ",", 
     RowBox[{"-", "1"}]}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.000817019866014*^9, 4.0008170285342903`*^9}, 
   4.000824465873323*^9, {4.0008271395096273`*^9, 4.0008272578583593`*^9}, {
   4.00082729525429*^9, 4.000827319890913*^9}, {4.00082735178997*^9, 
   4.0008273763585653`*^9}, 4.000827409043754*^9, {4.000827457541501*^9, 
   4.000827457776959*^9}, {4.00082771327486*^9, 4.000827734684552*^9}, {
   4.000828979795723*^9, 4.000829114850909*^9}, 4.000829455386366*^9, {
